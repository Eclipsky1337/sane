const ASCII_ZERO = '0';
const NEWLINE = '\n';

fn collatz(n: byte) -> byte {
    if n == 1 {
        return 1;
    }
    if n % 2 == 0 {
        return n / 2;
    } else {
        return 3 * n + 1;
    }
}

print "input a number: ";
let n = 0;
let buf = 0;

loop {
    read buf;
    if buf == NEWLINE {
        break;
    }
    n = n * 10 + (buf - ASCII_ZERO);
}

for let i = 0;; i += 1 {
    print "step {}: {}\n", i, n;
    if n == 1 {
        break;
    }
    n = collatz(n);
}
